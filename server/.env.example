# ==========================================
# Server Environment Configuration Template
# Truvora E-Commerce Platform
# ==========================================

# Server Port & Runtime Environment
PORT=4000
NODE_ENV=development
TRUST_PROXY=1

# PostgreSQL Database Connection String
DB_CONNECTION_STRING=postgresql://postgres:password@localhost:5432/truvora_db

# Authentication & Security
JWT_SECRET_KEY=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
SESSION_SECRET=your_session_secret_change_in_production

# Client & Backend Origin URLs
BACKEND_URL=http://localhost:4000
CLIENT_URL=http://localhost:5173

# Default Admin Credentials (Auto-seeded on first launch)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@truvora.com
ADMIN_PASSWORD=your_secure_admin_password

# Email / SMTP Service (Nodemailer for OTP & notifications)
EMAIL=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Cloudinary Media Storage (Product & Category Images)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_BASE_URL=https://api.cloudinary.com/v1_1
